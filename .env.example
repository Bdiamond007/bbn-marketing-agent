# Copier vers .env (jamais committé). Aucune valeur réelle ici.
# Mode local par défaut : simulateurs déterministes, sans secret ni compte cloud.
APP_ENV=development            # development | test | staging | production
APP_BASE_URL=http://localhost:3000
ADAPTER_MODE=fake              # fake | live  (fake refusé en production)
AUTH_MODE=fake                 # fake | cognito (fake refusé en production)

# PostgreSQL local (valeurs de développement uniquement)
DATABASE_URL=postgres://bbn_app:bbn_app_dev@localhost:5432/bbn
DATABASE_MIGRATION_URL=postgres://bbn_migrator:bbn_migrator_dev@localhost:5432/bbn
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# Requis seulement quand ADAPTER_MODE=live / AUTH_MODE=cognito
AWS_REGION=ca-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
S3_BUCKET_PRIVATE=
SQS_GENERATION_QUEUE_URL=
SQS_PUBLISHING_QUEUE_URL=
KMS_TOKEN_KEY_ID=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=
AI_PROVIDER=openai
AI_MODEL_TEXT=
AI_API_KEY=
SES_FROM_EMAIL=
SENTRY_DSN=

# Feature flags connecteurs (fermés tant que E03/E17 non prouvés en réel)
FEATURE_META_ENABLED=false
FEATURE_LINKEDIN_ENABLED=false
