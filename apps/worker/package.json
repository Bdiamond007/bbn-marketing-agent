{
  "name": "@bbn/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "esbuild src/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main.js --external:pg --external:drizzle-orm --external:zod --external:typescript",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bbn/config": "workspace:*",
    "@bbn/domain": "workspace:*",
    "@bbn/integrations": "workspace:*",
    "@bbn/observability": "workspace:*",
    "zod": "4.6.7",
    "@bbn/billing": "workspace:*",
    "@bbn/db": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
